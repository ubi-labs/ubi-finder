{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false,
      "dev": false,
      "codex/40-free-abuse-controls": false,
      "codex/staging-production-pipeline": false,
      "codex/lowercase-routes": false,
      "codex/sprint-1-staging": false
    }
  },
  "redirects": [
    {
      "source": "/Login",
      "destination": "/login",
      "permanent": true
    },
    {
      "source": "/Home",
      "destination": "/home",
      "permanent": true
    },
    {
      "source": "/About",
